NODE_ENV=development
# Hosted releases only: use deploy/run.cjs, not the demo bootstrap.
# APP_ENVIRONMENT=staging
# SERVE_FRONTENDS=true # API only; false on the separate worker
# APP_ROUTING_MODE=paths # existing local/demo/bootstrap routing
# Use subdomains only after all three custom domains have valid TLS certificates.
# APP_ROUTING_MODE=subdomains
PORT=4000
# Optional bind override. Development/test default to loopback; production defaults to all interfaces.
# BIND_HOST=127.0.0.1
# Only set for a verified reverse proxy topology. Direct development ignores forwarding headers.
# TRUST_PROXY_HOPS=0
# Staging behind Cloudflare + Render: use this INSTEAD OF TRUST_PROXY_HOPS.
# TRUST_PROXY_MODE=cloudflare-render
DATABASE_URL=postgres://postgres:postgres@localhost:5433/nitewide
DATABASE_SSL=false
# Per-statement and per-lock deadlines; background exports have explicit
# transaction-local 120s materialization and 30s batch deadlines.
DATABASE_STATEMENT_TIMEOUT_MS=120000
DATABASE_LOCK_TIMEOUT_MS=10000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=120000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_ACQUIRE_TIMEOUT_MS=30000
DATABASE_POOL_MAX=10
# Staging/production must use DATABASE_SSL=true (verified TLS).
# Optional CA for a database whose certificate is not signed by a public CA:
# DATABASE_SSL_CA_FILE=/absolute/path/to/database-ca.pem
# Alternatively DATABASE_SSL_CA supports PEM text, including escaped \\n line breaks.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
AUTH_TOKEN_SECRET=replace-this-with-at-least-32-random-characters
QR_TOKEN_SECRET=replace-this-with-a-different-random-qr-secret
EMAIL_ENCRYPTION_KEY=replace-this-with-a-different-random-email-key
# After copying this file, run: npm run secrets:generate -- --env-file .env
LOG_LEVEL=info
READINESS_TIMEOUT_MS=3000
API_SHUTDOWN_TIMEOUT_MS=30000
HTTP_REQUEST_TIMEOUT_MS=60000
# Sandbox-only Stripe Connect. Leave disabled until the sandbox is configured.
# Live keys and STRIPE_MODE=live are deliberately rejected.
STRIPE_MODE=disabled
# Optional temporary dev/test or HOSTED_DEMO routing. Never enable for production businesses.
# All new sandbox purchases share this existing, provider-verified merchant; normal account bindings remain unchanged.
# STRIPE_SANDBOX_SHARED_ACCOUNT_ID=acct_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# A separate signing secret from the sandbox webhook endpoint/local CLI listener:
# STRIPE_WEBHOOK_SECRET=whsec_...
# Separate Your-account thin-event destination for Accounts v2 readiness:
# STRIPE_ACCOUNT_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_CLIENT_ID=ca_... # Standard-account disconnect; use the same sandbox/platform as the keys above
# Optional transactional email (requires a verified sender domain in Resend).
# Keep the API key server-side only; a Codex Resend connection does not supply it to the app.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Nitewide <tickets@mail.yourdomain.com>
# Email types: staging defaults to essential (verification, reset, secure onboarding).
# Staging refuses all; disabled is the off switch. Dev/demo/production defaults remain all.
# EMAIL_DELIVERY_POLICY=essential
# For local Resend simulator addresses only; never use in production:
# RESEND_TEST_MODE=true
# Optional local delivery-event check: separate full-access read key if RESEND_API_KEY is sending-only.
# RESEND_TEST_READ_API_KEY=re_...
# CUSTOMER_APP_URL=http://localhost:5173
# BUSINESS_APP_URL=http://localhost:5174/app
# ADMIN_APP_URL=http://localhost:5175
# Subdomain staging (set on API AND worker, using the same verified image):
# CUSTOMER_APP_URL=https://staging.nitewide.com
# BUSINESS_APP_URL=https://business-staging.nitewide.com/app
# ADMIN_APP_URL=https://admin-staging.nitewide.com
# CORS_ORIGINS=https://staging.nitewide.com,https://business-staging.nitewide.com,https://admin-staging.nitewide.com
# Optional reviewer email alerts for new guestlist requests (default false):
# BUSINESS_GUESTLIST_REVIEW_EMAILS=true
# Separate background process: npm run dev:worker (included in npm run dev).
# These defaults cap each worker. Email pacing is shared across workers in the database.
EMAIL_WORKER_CONCURRENCY=2
EMAIL_WORKER_BATCH_SIZE=25
EMAIL_REQUEST_INTERVAL_MS=600
NOTIFICATION_WORKER_CONCURRENCY=2
EXPORT_WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=2000
WORKER_SHUTDOWN_TIMEOUT_MS=150000
# Server-side Census matching of public US venue addresses is automatic in
# staging/production via APP_ENVIRONMENT; local development, tests and demo stay off.
# No private/attendees-only addresses, browser GPS, keys, or automatic legacy backfill.
# Coordinates are Census address-range interpolation, not rooftop verification.
# Optional emergency pause, shared by API and worker; omit for normal release behavior.
# New/changed addresses queue while disabled.
# LOCATION_GEOCODING_PROVIDER=disabled
# Optional absolute directory for local event artwork; defaults to apps/api/uploads/events
# MEDIA_UPLOAD_DIR=/absolute/path/to/persistent/event-images
# Durable artwork: see docs/MEDIA_STORAGE.md. These settings are server-side only.
MEDIA_STORAGE_DRIVER=local
MEDIA_CLEANUP_ENABLED=false
# R2_ACCOUNT_ID=your-32-character-cloudflare-account-id
# R2_BUCKET=nitewide-dev-media
# R2_ACCESS_KEY_ID=your-r2-s3-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-s3-secret-access-key
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_READ_URL_TTL_SECONDS=900
MEDIA_CLEANUP_INTERVAL_MS=3600000
