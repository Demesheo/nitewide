NODE_ENV=development
PORT=4000
# Optional bind override. Development/test default to loopback; production defaults to all interfaces.
# BIND_HOST=127.0.0.1
# Only set for a verified reverse proxy topology. Direct development ignores forwarding headers.
# TRUST_PROXY_HOPS=0
DATABASE_URL=postgres://postgres:postgres@localhost:5433/nitewide
DATABASE_SSL=false
# Staging/production must use DATABASE_SSL=true (verified TLS).
# Optional CA for a database whose certificate is not signed by a public CA:
# DATABASE_SSL_CA_FILE=/absolute/path/to/database-ca.pem
# Alternatively DATABASE_SSL_CA supports PEM text, including escaped \\n line breaks.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
AUTH_TOKEN_SECRET=replace-this-with-at-least-32-random-characters
QR_TOKEN_SECRET=replace-this-with-a-different-random-qr-secret
EMAIL_ENCRYPTION_KEY=replace-this-with-a-different-random-email-key
# After copying this file, run: npm run secrets:generate -- --env-file .env
LOG_LEVEL=info
# Optional transactional email (requires a verified sender domain in Resend).
# Keep the API key server-side only; a Codex Resend connection does not supply it to the app.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Nitewide <tickets@mail.yourdomain.com>
# For local Resend simulator addresses only; never use in production:
# RESEND_TEST_MODE=true
# Optional local delivery-event check: separate full-access read key if RESEND_API_KEY is sending-only.
# RESEND_TEST_READ_API_KEY=re_...
# CUSTOMER_APP_URL=http://localhost:5173
# BUSINESS_APP_URL=http://localhost:5174/app
# Optional reviewer email alerts for new guestlist requests (default false):
# BUSINESS_GUESTLIST_REVIEW_EMAILS=true
# Separate background process: npm run dev:worker (included in npm run dev).
# These defaults cap each worker. Email pacing is shared across workers in the database.
EMAIL_WORKER_CONCURRENCY=2
EMAIL_WORKER_BATCH_SIZE=25
EMAIL_REQUEST_INTERVAL_MS=600
NOTIFICATION_WORKER_CONCURRENCY=2
EXPORT_WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=2000
WORKER_SHUTDOWN_TIMEOUT_MS=150000
# Optional absolute directory for local event artwork; defaults to apps/api/uploads/events
# MEDIA_UPLOAD_DIR=/absolute/path/to/persistent/event-images
