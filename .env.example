NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/nitewide
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
AUTH_TOKEN_SECRET=replace-this-with-at-least-32-random-characters
LOG_LEVEL=info
# Optional transactional email (requires a verified sender domain in Resend).
# Keep the API key server-side only; a Codex Resend connection does not supply it to the app.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Nitewide <tickets@mail.yourdomain.com>
# For local Resend simulator addresses only; never use in production:
# RESEND_TEST_MODE=true
# Optional local delivery-event check: separate full-access read key if RESEND_API_KEY is sending-only.
# RESEND_TEST_READ_API_KEY=re_...
# CUSTOMER_APP_URL=http://localhost:5173
# BUSINESS_APP_URL=http://localhost:5174/app
# Optional reviewer email alerts for new guestlist requests (default false):
# BUSINESS_GUESTLIST_REVIEW_EMAILS=true
# Optional absolute directory for local event artwork; defaults to apps/api/uploads/events
# MEDIA_UPLOAD_DIR=/absolute/path/to/persistent/event-images
